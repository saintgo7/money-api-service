# Production Environment Configuration

# Application
APP_NAME=Money API Service
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Database
DATABASE_URL=postgresql+asyncpg://postgres:STRONG_PASSWORD@db-host:5432/money_api
REDIS_URL=redis://redis-host:6379/0
CLICKHOUSE_HOST=clickhouse-host
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=api_analytics

# AI APIs (Add your production keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=

# Kafka (if using)
KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092
KAFKA_TOPIC_USAGE=api-usage-events

# Rate Limiting
RATE_LIMIT_FREE=10
RATE_LIMIT_STARTER=60
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1000

# Pricing (USD)
PRICE_TEXT_CLAUDE=0.003
PRICE_TEXT_GPT4=0.006
PRICE_IMAGE_SDXL=0.02
PRICE_IMAGE_DALLE=0.04
PRICE_AUDIO_TRANSCRIBE=0.006
PRICE_AUDIO_SYNTHESIZE=0.015

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
FROM_EMAIL=noreply@moneyapi.example.com

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# CORS (comma-separated)
CORS_ORIGINS=https://dashboard.moneyapi.example.com,https://moneyapi.example.com

# Security
ALLOWED_HOSTS=api.moneyapi.example.com
ENABLE_HTTPS=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_WEBHOOKS=true
ENABLE_ADMIN_API=true
ENABLE_ANALYTICS=true
